  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@storybook/react-native": "^10.7.1",
    "@tamagui/cli": "^3.3.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "assets": "node scripts/generate-assets.mjs",
    "test:e2e": "zsh scripts/e2e-ios.sh",
    "test:e2e:server": "zsh e2e/server/run.sh",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:db": "node --test supabase/tests/rls.test.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^~/(.*)$": "<rootDir>/$1",
      "^@tamagui/style-grammar/token-categories$": "<rootDir>/node_modules/@tamagui/style-grammar/dist/cjs/tokenCategories.cjs",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|tamagui|@tamagui/.*|sonner-native|supercluster|kdbush|standard-navigation|@expo-google-fonts/.*))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "watchman": false,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "cjs",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/",
      "supabase/tests/"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
